# Slim Linux image for EMBER GBDT same-sample audits.
# CPU only. No CUDA. Bind-mount the repo and PE corpus at runtime.
#
#   docker build -f scripts/Dockerfile.ember-linux -t neurinspectre:ember-linux scripts/
#   bash scripts/audit_ember_linux_native.sh /path/to/pe_dir
#
# This is Linux, so mac_inconsistent is false. It is still not Elastic-verified
# unless lief is 0.9.0 or 0.10.1 (ember's current API needs 0.13.x).
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 \
        python3.10-dev \
        python3-pip \
        git \
        ca-certificates \
        build-essential \
        cmake \
        pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/local/bin/python \
    && ln -sf /usr/bin/python3.10 /usr/local/bin/python3

WORKDIR /app

RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install \
        "numpy>=1.21.0,<2.0.0" \
        "scipy>=1.7.0" \
        "scikit-learn>=1.0.0" \
        "torch" \
        --extra-index-url https://download.pytorch.org/whl/cpu \
    && python3 -m pip install \
        "lightgbm" \
        "pefile" \
        "lief>=0.13,<0.14" \
        "click>=8.1.0" \
        "pyyaml>=6.0" \
        "rich>=13.7.0" \
        "rich-click>=1.8.0" \
        "tqdm>=4.65.0" \
        "pandas>=1.3.0" \
    && python3 -m pip install "git+https://github.com/elastic/ember.git" --no-deps

ENTRYPOINT ["python3"]
